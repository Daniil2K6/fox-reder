# Node modules
frontend/node_modules/
backend/.venv/

# Python
__pycache__/
*.py[cod]

# Build outputs
frontend/.next/
frontend/out/

# Database files (CRITICAL: keep data out of version control)
backend/fox_reader.db
backend/fox_reader.db-shm
backend/fox_reader.db-wal
backend/fox_reader.db-journal

# User storage directory (books, covers, avatars, series)
# CRITICAL: Do not commit librali directory to avoid data leaks
backend/librali/

# Environment variables (CRITICAL: never commit secrets)
.env
.env.local
.env.*.local
.env.production

# Uploads and covers (legacy paths, now covered by librali/)
backend/uploads/*
backend/covers/*
!backend/uploads/.gitkeep
!backend/covers/.gitkeep

# Logs
*.log
backend/backend.log
frontend/frontend.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Temporary files
*.tmp
*.temp

# WARNING / Plans (personal notes)
WARNING.md

# AI Assistant guide
AI_ASSISTANT.md

# Test folder
test_folder/

# Converter models
converter/models/

# Converter build artifacts
converter/llama.cpp/build/

# Personal ideas / notes
forum-idea.md

# Build artifacts (TypeScript)
frontend/tsconfig.tsbuildinfo

# Server PID file
backend/.server.pid

